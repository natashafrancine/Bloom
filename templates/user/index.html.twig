{% extends 'base.html.twig' %}

{% block title %}Users - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold text-pink mb-2" style="font-family: 'Bauhaus 93 Regular', sans-serif;">User Management</h1>
        <p class="text-muted">Manage all registered users</p>
    </div>

    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div>
            <a href="{{ path('user_index') }}" class="btn btn-outline-secondary btn-sm {% if not app.request.query.get('role') %}active{% endif %}">All</a>
            <a href="{{ path('user_index', {'role': 'ROLE_USER'}) }}" class="btn btn-outline-secondary btn-sm {% if app.request.query.get('role') == 'ROLE_USER' %}active{% endif %}">Users</a>
            <a href="{{ path('user_index', {'role': 'ROLE_ADMIN'}) }}" class="btn btn-outline-secondary btn-sm {% if app.request.query.get('role') == 'ROLE_ADMIN' %}active{% endif %}">Admins</a>
            <a href="{{ path('user_index', {'role': 'ROLE_STAFF'}) }}" class="btn btn-outline-secondary btn-sm {% if app.request.query.get('role') == 'ROLE_STAFF' %}active{% endif %}">Staff</a>
        </div>
        <a href="{{ path('user_new') }}" class="btn btn-pink px-4">➕ Add New User</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.name }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% set display_roles = [] %}
                                    {% for role in user.roles %}
                                        {% if role != 'ROLE_USER' %}
                                            {% set display_roles = display_roles|merge([role]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if display_roles is empty %}
                                        {% set display_roles = ['ROLE_USER'] %}
                                    {% endif %}
                                    {% for role in display_roles %}
                                        <span class="badge bg-secondary">{{ role }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    <form method="post" action="{{ path('user_toggle_status', {'id': user.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ user.id) }}">
                                        <button type="submit" style="border: none; background: none; padding: 0; cursor: pointer;">
                                            {% if user.status == 'ACTIVE' %}
                                                <span class="badge bg-success">{{ user.status }}</span>
                                            {% elseif user.status == 'INACTIVE' %}
                                                <span class="badge bg-danger">{{ user.status }}</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ user.status }}</span>
                                            {% endif %}
                                        </button>
                                    </form>
                                </td>
                                    <a href="{{ path('user_show', {'id': user.id}) }}" class="btn btn-sm btn-info">👁️ View</a>
                                    <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning">✏️ Edit</a>
                                    <form method="post" action="{{ path('user_delete', {'id': user.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">🗑️ Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">No users found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}