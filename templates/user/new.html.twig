{% extends 'base.html.twig' %}

{% block title %}New User - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold text-pink mb-2" style="font-family: 'Bauhaus 93 Regular', sans-serif;">Create New User</h1>
        <p class="text-muted">Add a new user to the system</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="name" class="form-label">Name *</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email *</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password *</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-pink">Create User</button>
                            <a href="{{ path('user_index') }}" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}