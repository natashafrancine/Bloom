{% extends 'base.html.twig' %}

{% block title %}Activity Logs - {{ parent() }}{% endblock %}

{% block body %}
<style>
    .activity-header {
        font-family: 'Bauhaus 93 Regular', sans-serif;
        color: var(--pink);
        font-size: 2.5rem;
        margin-bottom: 30px;
        text-shadow: 2px 2px 4px rgba(219, 39, 119, 0.1);
    }

    .filter-card {
        background: white;
        border: 2px solid var(--pink);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(219, 39, 119, 0.1);
        transition: all 0.3s ease;
    }

    .filter-card:hover {
        box-shadow: 0 6px 20px rgba(219, 39, 119, 0.15);
        transform: translateY(-2px);
    }

    .filter-card h6 {
        color: var(--pink);
        font-weight: 700;
        margin-bottom: 20px;
    }

    .form-select, .form-control {
        border: 2px solid #ddd;
        border-radius: 10px;
        padding: 10px 15px;
        transition: all 0.3s ease;
        font-family: 'Cascadia Code', monospace;
    }

    .form-select:focus, .form-control:focus {
        border-color: var(--pink);
        box-shadow: 0 0 0 0.2rem rgba(219, 39, 119, 0.25);
    }

    .btn-filter {
        background: linear-gradient(135deg, var(--pink) 0%, var(--pink-hover) 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-family: 'Cascadia Code', monospace;
    }

    .btn-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(219, 39, 119, 0.3);
        color: white;
    }

    .btn-clear {
        background: #e9ecef;
        border: none;
        color: #6c757d;
        font-weight: 600;
        padding: 10px 25px;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-family: 'Cascadia Code', monospace;
    }

    .btn-clear:hover {
        background: #dee2e6;
        color: #495057;
        transform: translateY(-2px);
    }

    .activity-table-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(219, 39, 119, 0.1);
        overflow: hidden;
        border: 2px solid var(--pink);
    }

    .activity-table-header {
        background: linear-gradient(135deg, var(--pink) 0%, var(--pink-hover) 100%);
        color: white;
        padding: 20px 25px;
    }

    .activity-table-header h6 {
        margin: 0;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .activity-table {
        margin: 0;
        font-family: 'Cascadia Code', monospace;
    }

    .activity-table thead th {
        background: #f8f9fa;
        border: none;
        border-bottom: 2px solid var(--pink);
        color: var(--pink);
        font-weight: 700;
        padding: 18px 15px;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .activity-table tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid #e9ecef;
    }

    .activity-table tbody tr:hover {
        background-color: rgba(219, 39, 119, 0.05);
        transform: scale(1.001);
    }

    .activity-table tbody td {
        padding: 15px;
        vertical-align: middle;
        color: var(--text-color);
        border: none;
    }

    .user-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        background: linear-gradient(135deg, rgba(219, 39, 119, 0.1), rgba(244, 114, 182, 0.1));
        border-radius: 8px;
        font-weight: 600;
        color: var(--pink);
    }

    .user-badge i {
        font-size: 1.1rem;
    }

    .action-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .action-created {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .action-updated {
        background-color: #cfe2ff;
        color: #084298;
        border: 1px solid #b6d4fe;
    }

    .action-deleted {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .action-viewed {
        background-color: #e2e3e5;
        color: #383d41;
        border: 1px solid #d3d6d8;
    }

    .action-cancelled {
        background-color: #fff3cd;
        color: #664d03;
        border: 1px solid #ffecb5;
    }

    .action-status {
        background-color: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .action-shop {
        background-color: #e7d4f5;
        color: #6c3483;
        border: 1px solid #d7bde2;
    }

    .time-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .time-badge i {
        color: var(--pink);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 4rem;
        color: rgba(219, 39, 119, 0.2);
        margin-bottom: 20px;
        display: block;
    }

    .empty-state p {
        font-size: 1.1rem;
        margin: 0;
    }

    @media (max-width: 768px) {
        .activity-header {
            font-size: 2rem;
        }

        .activity-table {
            font-size: 0.9rem;
        }

        .activity-table tbody td {
            padding: 12px 8px;
        }

        .activity-table thead th {
            padding: 12px 8px;
        }

        .user-badge, .time-badge {
            flex-direction: column;
            align-items: flex-start;
        }

        .action-badge {
            font-size: 0.75rem;
            padding: 5px 10px;
        }
    }

    /* User Search Autocomplete */
    .user-search-wrapper {
        position: relative;
    }

    .user-search-input {
        border: 2px solid #ddd;
        border-radius: 10px;
        padding: 10px 15px;
        font-family: 'Cascadia Code', monospace;
        transition: all 0.3s ease;
        width: 100%;
    }

    .user-search-input:focus {
        border-color: var(--pink);
        box-shadow: 0 0 0 0.2rem rgba(219, 39, 119, 0.25);
        outline: none;
    }

    .user-suggestions {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 2px solid var(--pink);
        border-top: none;
        border-radius: 0 0 10px 10px;
        max-height: 300px;
        overflow-y: auto;
        z-index: 1000;
        display: none;
        box-shadow: 0 4px 12px rgba(219, 39, 119, 0.2);
    }

    .user-suggestions.active {
        display: block;
    }

    .user-suggestion-item {
        padding: 12px 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-suggestion-item:last-child {
        border-bottom: none;
    }

    .user-suggestion-item:hover {
        background-color: rgba(219, 39, 119, 0.1);
        padding-left: 20px;
    }

    .user-suggestion-item.highlighted {
        background-color: rgba(219, 39, 119, 0.15);
        font-weight: 600;
    }

    .user-suggestion-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pink), var(--pink-hover));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .user-suggestion-info {
        flex: 1;
    }

    .user-suggestion-name {
        font-weight: 600;
        color: var(--pink);
        margin-bottom: 2px;
    }

    .user-suggestion-email {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .suggestion-no-results {
        padding: 20px 15px;
        text-align: center;
        color: #6c757d;
        font-size: 0.9rem;
    }

</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="activity-header">
                <i class="bi bi-clock-history"></i> Activity Logs
            </h1>

            <!-- Filters -->
            <div class="filter-card">
                <h6><i class="bi bi-funnel"></i> Filter Activities</h6>
                <form method="GET" class="row g-3" id="filterForm">
                    <div class="col-md-4">
                        <label for="userSearch" class="form-label fw-600" style="color: var(--pink);">Filter by User</label>
                        <div class="user-search-wrapper">
                            <input 
                                type="text" 
                                id="userSearch" 
                                class="user-search-input" 
                                placeholder="Type name or email..."
                                autocomplete="off"
                            >
                            <input type="hidden" id="userFilter" name="user" value="{{ user_filter }}">
                            <div class="user-suggestions" id="userSuggestions"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="action" class="form-label fw-600" style="color: var(--pink);">Filter by Action</label>
                        <input type="text" name="action" id="action" class="form-control" value="{{ action_filter }}" placeholder="e.g., Created, Updated, Deleted...">
                    </div>
                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-filter flex-grow-1">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a href="{{ path('activity_log_index') }}" class="btn btn-clear">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </a>
                    </div>
                </form>
            </div>

            <!-- Activity Logs Table -->
            <div class="activity-table-card">
                <div class="activity-table-header">
                    <h6>
                        <i class="bi bi-table"></i>
                        Recent Activities ({{ activity_logs|length }} records)
                    </h6>
                </div>
                <div class="table-responsive">
                    {% if activity_logs is empty %}
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>No activity logs found. Your activities will appear here.</p>
                        </div>
                    {% else %}
                        <table class="table activity-table">
                            <thead>
                                <tr>
                                    <th width="20%"><i class="bi bi-person-circle"></i> User</th>
                                    <th width="20%"><i class="bi bi-lightning"></i> Action</th>
                                    <th width="40%"><i class="bi bi-chat-dots"></i> Description</th>
                                    <th width="20%"><i class="bi bi-calendar-event"></i> Date & Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for log in activity_logs %}
                                <tr>
                                    <td>
                                        <div class="user-badge">
                                            <i class="bi bi-person-fill"></i>
                                            <div>
                                                <div style="font-size: 0.95rem;">{{ log.user.name }}</div>
                                                <small style="opacity: 0.7; display: block;">{{ log.user.email }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% set actionClass = 'action-viewed' %}
                                        {% if 'Created' in log.action %}
                                            {% set actionClass = 'action-created' %}
                                        {% elseif 'Updated' in log.action or 'Changed' in log.action %}
                                            {% set actionClass = 'action-updated' %}
                                        {% elseif 'Deleted' in log.action or 'Removed' in log.action %}
                                            {% set actionClass = 'action-deleted' %}
                                        {% elseif 'Cancelled' in log.action %}
                                            {% set actionClass = 'action-cancelled' %}
                                        {% elseif 'Status' in log.action %}
                                            {% set actionClass = 'action-status' %}
                                        {% elseif 'Shop' in log.action %}
                                            {% set actionClass = 'action-shop' %}
                                        {% endif %}
                                        <span class="action-badge {{ actionClass }}">
                                            {{ log.action }}
                                        </span>
                                    </td>
                                    <td style="color: #6c757d; font-size: 0.95rem;">
                                        {{ log.description ?: '—' }}
                                    </td>
                                    <td>
                                        <div class="time-badge">
                                            <i class="bi bi-clock"></i>
                                            <span>{{ log.createdAt|date('M j, Y g:i A') }}</span>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // User data from the template
    const allUsers = [
        {% for user in users %}
            {
                id: {{ user.id }},
                name: '{{ user.name }}',
                email: '{{ user.email }}'
            }{{ not loop.last ? ',' : '' }}
        {% endfor %}
    ];

    const userSearch = document.getElementById('userSearch');
    const userFilter = document.getElementById('userFilter');
    const userSuggestions = document.getElementById('userSuggestions');
    const filterForm = document.getElementById('filterForm');
    let currentHighlightIndex = -1;

    // Initialize: If user was previously selected, show their name
    if (userFilter.value) {
        const selectedUser = allUsers.find(u => u.id == userFilter.value);
        if (selectedUser) {
            userSearch.value = selectedUser.name;
        }
    }

    // Handle user search input
    userSearch.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        currentHighlightIndex = -1;

        if (!query) {
            userSuggestions.classList.remove('active');
            userFilter.value = '';
            return;
        }

        // Filter users by name or email (word by word)
        const filteredUsers = allUsers.filter(user => {
            const name = user.name.toLowerCase();
            const email = user.email.toLowerCase();
            
            // Split query into words and check if all words match
            const queryWords = query.split(/\s+/);
            return queryWords.every(word => name.includes(word) || email.includes(word));
        });

        // Display suggestions
        if (filteredUsers.length > 0) {
            userSuggestions.innerHTML = filteredUsers.map((user, index) => `
                <div class="user-suggestion-item" data-user-id="${user.id}" data-index="${index}">
                    <div class="user-suggestion-avatar">${user.name.charAt(0).toUpperCase()}</div>
                    <div class="user-suggestion-info">
                        <div class="user-suggestion-name">${highlightMatch(user.name, query)}</div>
                        <div class="user-suggestion-email">${highlightMatch(user.email, query)}</div>
                    </div>
                </div>
            `).join('');
            userSuggestions.classList.add('active');

            // Add click handlers to suggestions
            document.querySelectorAll('.user-suggestion-item').forEach(item => {
                item.addEventListener('click', () => {
                    const userId = item.getAttribute('data-user-id');
                    const userName = allUsers.find(u => u.id == userId).name;
                    userSearch.value = userName;
                    userFilter.value = userId;
                    userSuggestions.classList.remove('active');
                });
            });
        } else {
            userSuggestions.innerHTML = '<div class="suggestion-no-results">No users found</div>';
            userSuggestions.classList.add('active');
        }
    });

    // Keyboard navigation
    userSearch.addEventListener('keydown', (e) => {
        const items = document.querySelectorAll('.user-suggestion-item');
        
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            currentHighlightIndex = Math.min(currentHighlightIndex + 1, items.length - 1);
            updateHighlight(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            currentHighlightIndex = Math.max(currentHighlightIndex - 1, -1);
            updateHighlight(items);
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (currentHighlightIndex >= 0 && items[currentHighlightIndex]) {
                items[currentHighlightIndex].click();
            } else {
                filterForm.submit();
            }
        } else if (e.key === 'Escape') {
            userSuggestions.classList.remove('active');
        }
    });

    function updateHighlight(items) {
        items.forEach((item, index) => {
            item.classList.toggle('highlighted', index === currentHighlightIndex);
        });
    }

    // Close suggestions when clicking outside
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.user-search-wrapper')) {
            userSuggestions.classList.remove('active');
        }
    });

    // Highlight matching text
    function highlightMatch(text, query) {
        const queryWords = query.split(/\s+/);
        let highlighted = text;
        
        queryWords.forEach(word => {
            const regex = new RegExp(`(${word})`, 'gi');
            highlighted = highlighted.replace(regex, '<strong style="color: var(--pink);">$1</strong>');
        });
        
        return highlighted;
    }
</script>
{% endblock %}