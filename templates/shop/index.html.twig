{% extends 'base.html.twig' %}

{% block title %}Shops - BLOOM{% endblock %}

{% block body %}
<div class="container mx-auto py-10 px-4">

    <!-- 🌸 Page Header -->
    <div class="text-center mb-10">
        <h1 class="text-4xl font-bold text-pink-600 mb-2" style="font-family: 'Bauhaus 93 Regular', cursive;">
            Our Shops
        </h1>
        <p class="text-gray-600 text-lg" style="font-family: 'Cascadia Code', monospace;">
            Discover our charming collection of blooms — explore, admire, and find your perfect floral treasure 🌸
        </p>
    </div>

    {% if shopProducts is empty %}
        <div class="text-center py-10">
            <p class="text-gray-500 text-lg">No products in shop at the moment 🌷</p>
        </div>
    {% else %}
        <div class="mb-10 p-6 bg-white shadow-md rounded-xl border border-gray-100">

            <!-- 🏪 Shop Title -->
            <h2 class="text-2xl font-extrabold text-pink-600 text-center mb-4">
                Shop Products
            </h2>
            <p class="text-center text-gray-500 mb-6">Products added to the shop</p>

            <!-- 🪷 Product Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {% for product in shopProducts %}
                            <div class="bg-white rounded-xl shadow hover:shadow-lg transition p-4 flex flex-col">
                                <!-- Product Image -->
                                <div class="relative w-full h-56 overflow-hidden rounded-xl mb-4">
                                    {% if product.image %}
                                        <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}" class="w-full h-full object-cover">
                                    {% else %}
                                        <img src="{{ asset('uploads/no-image.png') }}" alt="No Image" class="w-full h-full object-cover">
                                    {% endif %}
                                </div>

                                <!-- Product Info -->
                                <div class="flex-1 flex flex-col justify-between">
                                    <div class="mb-2">
                                        <h5 class="text-lg font-bold text-pink-600 mb-1">{{ product.name }}</h5>
                                        <p class="text-sm text-gray-500 mb-1">{{ product.category ? product.category.name : 'Uncategorized' }}</p>
                                        <p class="text-sm text-gray-600 mb-2">{{ product.description|length > 70 ? product.description|slice(0,70) ~ '...' : product.description }}</p>
                                        <p class="font-semibold text-gray-800 mb-1">₱{{ product.price|number_format(2, '.', ',') }}</p>
                                        <p class="text-xs text-gray-400 mb-2">Stock: {{ product.stock }}</p>
                                    </div>

                                </div>
                            </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>

<script>
function incrementQty(productId) {
    const input = document.getElementById('qty-' + productId);
    if (parseInt(input.value) < parseInt(input.max)) input.value = parseInt(input.value) + 1;
}
function decrementQty(productId) {
    const input = document.getElementById('qty-' + productId);
    if (parseInt(input.value) > parseInt(input.min)) input.value = parseInt(input.value) - 1;
}
function addToCart(productId) {
    const qty = document.getElementById('qty-' + productId)?.value || 1;
    console.log(`Add product ${productId} to cart, qty: ${qty}`);
    // TODO: AJAX call to add to cart
}
</script>

<style>
.text-pink-600 { color: #DB2777; }
.bg-pink-600 { background-color: #DB2777; }
.bg-pink-700 { background-color: #b91c6b; }
</style>
{% endblock %}
