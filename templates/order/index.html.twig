{% extends 'base.html.twig' %}

{% block title %}Orders - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold text-pink mb-2" style="font-family: 'Bauhaus 93'; font-size: 2.5rem;">📋 My Orders</h1>
        <p class="text-muted">View and manage all your orders</p>
    </div>

    <!-- Search and Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Search by order ID, customer name, or email">
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label">Order Status</label>
                    <select class="form-control" id="status" name="status">
                        <option value="">All Statuses</option>
                        <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
                        <option value="processing" {% if status == 'processing' %}selected{% endif %}>Processing</option>
                        <option value="shipped" {% if status == 'shipped' %}selected{% endif %}>Shipped</option>
                        <option value="completed" {% if status == 'completed' %}selected{% endif %}>Completed</option>
                        <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="payment_status" class="form-label">Payment Status</label>
                    <select class="form-control" id="payment_status" name="payment_status">
                        <option value="">All Payment Statuses</option>
                        <option value="pending" {% if payment_status == 'pending' %}selected{% endif %}>Pending</option>
                        <option value="paid" {% if payment_status == 'paid' %}selected{% endif %}>Paid</option>
                        <option value="failed" {% if payment_status == 'failed' %}selected{% endif %}>Failed</option>
                        <option value="refunded" {% if payment_status == 'refunded' %}selected{% endif %}>Refunded</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-pink me-2">🔍 Search</button>
                    <a href="{{ path('order_index') }}" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    {% if orders is empty %}
        <div class="alert alert-info text-center py-5" role="alert">
            <h5 class="fw-bold">No orders yet</h5>
            <p class="mb-3">You haven't placed any orders yet. Start shopping to create your first order!</p>
            <a href="{{ path('shop_index') }}" class="btn btn-pink px-4">🛍️ Start Shopping</a>
        </div>
    {% else %}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="text-muted">Showing {{ orders|length }} order{{ orders|length != 1 ? 's' : '' }}</span>
            </div>
            <a href="{{ path('order_new') }}" class="btn btn-pink px-4">
                <i class="bi bi-plus-circle"></i> Create Order
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td><strong>#{{ order.id }}</strong></td>
                            <td>{{ order.createdAt|date('M d, Y h:i A') }}</td>
                            <td>{{ order.customerName }}</td>
                            <td>{{ order.orderItems|length }}</td>
                            <td>
                                {% if order.status == 'pending' %}
                                    <span class="badge bg-warning">Pending</span>
                                {% elseif order.status == 'completed' %}
                                    <span class="badge bg-success">Completed</span>
                                {% elseif order.status == 'cancelled' %}
                                    <span class="badge bg-danger">Cancelled</span>
                                {% elseif order.status == 'shipped' %}
                                    <span class="badge bg-info">Shipped</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ order.status|title }}</span>
                                {% endif %}
                            </td>
                            <td><span class="text-pink fw-bold">₱{{ order.totalAmount|number_format(2, '.', ',') }}</span></td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('order_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                    <a href="{{ path('order_edit', {'id': order.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" action="{{ path('order_delete', {'id': order.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this order?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<style>
    body {
        background-color: #FAFAFA;
        font-family: 'Poppins', sans-serif;
        color: #374151;
    }
    
    .text-pink {
        color: #DB2777;
    }
    
    .btn-pink {
        background-color: #DB2777;
        border-color: #DB2777;
        transition: all 0.3s ease;
    }
    
    .btn-pink:hover {
        background-color: #b8214d;
        border-color: #b8214d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(219, 39, 119, 0.3);
    }
    
    .card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    
    .card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        transform: translateY(-4px);
    }
</style>
{% endblock %}
