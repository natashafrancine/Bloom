<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% block title %}
        BLOOM
      {% endblock %}
    </title>

    <link rel="icon" type="image/png" href="{{ asset('uploads/bloom 2.png') }}" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    {% block stylesheets %}
      <style>
    :root {
      --pink: #DB2777;
      --pink-hover: #F472B6;
      --light-bg: #FFF8FB;
      --text-color: #3d2a2a;
    }

    body {
      font-family: 'Cascadia Code', monospace;
      color: var(--text-color);
      background-color: var(--light-bg);
      background-image: url(';
    }
    .logo-img {
      width: 100%;
      max-width: 200px;
      height: 50px;
      object-fit: contain;
      margin: 0 auto 20px;
    }
    .logo-img:hover {
      transform: scale(1.02);
    }
    </style>
    {% endblock %}
  </head>

  <body class="d-flex flex-column min-vh-100 fade-out">
    <!-- 🌸 Sidebar Navigation -->
    {% block header %}
      <aside class="sidebar">
        <div class="sidebar-content">
          <div class="text-center">
            <a href="{{ path('app_home') }}">
              <img src="{{ asset('uploads/bloom 2.png') }}" alt="Bloom Logo" class="logo-img" />
              {# <span class="brand-text">Admin Panel</span> #}
            </a>
          </div>
          <nav class="mt-4">
            <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}{% endif %}" href="{{ path('app_home') }}">Dashboard Overview</a>
            {#
        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_about' %}active{% endif %}" href="{{ path('app_about') }}">🌺 About</a>
        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}" href="{{ path('app_contact') }}">📞 Contact</a>
        #}
            <a class="nav-link {% if app.request.attributes.get('_route') starts with 'product' %}{% endif %}" href="{{ path('product_index') }}">Products</a>
            <a class="nav-link {% if app.request.attributes.get('_route') starts with 'order' %}{% endif %}" href="{{ path('order_index') }}">Orders</a>
            {% if is_granted('ROLE_ADMIN') %}
              <a class="nav-link {% if app.request.attributes.get('_route') starts with 'user' %}{% endif %}" href="{{ path('user_index') }}">Users</a>
              <a class="nav-link {% if app.request.attributes.get('_route') starts with 'activity_log' %}{% endif %}" href="{{ path('activity_log_index') }}">Activity Logs</a>
            {% endif %}
          </nav>
        </div>

        {% if app.user %}
          <div class="user-info">
            <p class="mb-2 text-white-50 small">Logged in as:</p>
            <p class="mb-3 text-white">{{ app.user.email }}</p>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm w-100">Logout</a>
          </div>
        {% endif %}
      </aside>
    {% endblock %}

    <!-- 🌺 Main Content Area -->
    <div class="main-content flex-fill">
      <main>
        {% for message in app.flashes('error') %}
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message|raw }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
        {% block body %}

        {% endblock %}
      </main>

      {% block footer %}
        <footer class="text-light text-center py-3 mt-4 rounded-bottom">
          <div class="container">
            <small>© {{ 'now'|date('Y') }} Bloom Shop | All Rights Reserved 🌷</small>
          </div>
        </footer>
      {% endblock %}
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}

    {% endblock %}
  </body>
</html>
