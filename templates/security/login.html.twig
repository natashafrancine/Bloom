<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - BLOOM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
      :root {
        --pink: #db2777;
        --pink-hover: #f472b6;
        --light-bg: #fff8fb;
        --text-color: #3d2a2a;
        --error-color: #dc3545;
        --success-color: #28a745;
      }
      
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Cascadia Code', monospace;
        color: var(--text-color);
        background: linear-gradient(135deg, var(--pink) 0%, var(--pink-hover) 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      
      .auth-container {
        width: 100%;
        max-width: 420px;
      }
      
      .auth-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        overflow: hidden;
      }
      
      .auth-header {
        background: linear-gradient(135deg, var(--pink) 0%, var(--pink-hover) 100%);
        padding: 30px 20px;
        text-align: center;
        color: white;
      }
      
      .auth-header h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
      }
      
      .auth-header p {
        margin: 8px 0 0 0;
        opacity: 0.9;
        font-size: 14px;
      }
      
      .auth-body {
        padding: 40px 30px;
      }
      
      .form-group {
        margin-bottom: 20px;
      }
      
      .form-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--text-color);
        font-size: 14px;
      }
      
      .form-control {
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-family: inherit;
        font-size: 14px;
        transition: all 0.3s ease;
        background-color: #fafafa;
      }
      
      .form-control:focus {
        outline: none;
        border-color: var(--pink);
        background-color: white;
        box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.1);
      }
      
      .form-control::placeholder {
        color: #999;
      }
      
      .form-check {
        margin-bottom: 15px;
      }
      
      .form-check-input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        border: 2px solid #e0e0e0;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      
      .form-check-input:checked {
        background-color: var(--pink);
        border-color: var(--pink);
      }
      
      .form-check-input:focus {
        border-color: var(--pink);
        box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.1);
      }
      
      .form-check-label {
        margin-left: 8px;
        font-size: 14px;
        cursor: pointer;
        user-select: none;
      }
      
      .btn-sign-in {
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, var(--pink) 0%, var(--pink-hover) 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 10px;
      }
      
      .btn-sign-in:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(219, 39, 119, 0.3);
      }
      
      .btn-sign-in:active {
        transform: translateY(0);
      }
      
      .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      
      .alert-danger {
        background-color: #fee;
        color: var(--error-color);
        border-left: 4px solid var(--error-color);
      }
      
      .alert-success {
        background-color: #efe;
        color: var(--success-color);
        border-left: 4px solid var(--success-color);
      }
      
      .alert-danger i,
      .alert-success i {
        font-size: 18px;
      }
      
      .divider {
        display: flex;
        align-items: center;
        margin: 25px 0;
        gap: 10px;
        font-size: 12px;
        color: #999;
      }
      
      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e0e0e0;
      }
      
      .auth-footer {
        padding: 20px 30px;
        background: #fafafa;
        text-align: center;
        border-top: 1px solid #e0e0e0;
      }
      
      .auth-footer p {
        margin: 0;
        font-size: 14px;
        color: #666;
      }
      
      .auth-footer a {
        color: var(--pink);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
      }
      
      .auth-footer a:hover {
        color: var(--pink-hover);
        text-decoration: underline;
      }
      
      .input-error {
        border-color: var(--error-color) !important;
      }
      
      .input-error ~ .error-message {
        display: block;
        color: var(--error-color);
        font-size: 12px;
        margin-top: 5px;
      }
      
      .error-message {
        display: none;
      }
    </style>
  </head>
  <body>
    <div class="auth-container">
      {% if app.request.attributes.get('_route') == 'app_login' and app.flashes('success') %}
        {% for message in app.flashes('success') %}
          <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle"></i>
            {{ message }}
          </div>
        {% endfor %}
      {% endif %}

      <div class="auth-card">
        <div class="auth-header">
          <h1>BLOOM</h1>
          <p>Welcome back</p>
        </div>

        <div class="auth-body">
          {% if error %}
            <div class="alert alert-danger" role="alert">
              <i class="bi bi-exclamation-circle"></i>
              {{ error.message }}
            </div>
          {% endif %}

          <form method="post" novalidate>
            <div class="form-group">
              <label for="inputEmail" class="form-label">Email Address</label>
              <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="you@example.com" autocomplete="email" required autofocus />
            </div>

            <div class="form-group">
              <label for="inputPassword" class="form-label">Password</label>
              <input type="password" name="password" id="inputPassword" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
            </div>

            <div class="form-check">
              <input type="checkbox" name="_remember_me" id="rememberMe" class="form-check-input" />
              <label class="form-check-label" for="rememberMe">Keep me signed in</label>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}" />

            <button class="btn-sign-in" type="submit"><i class="bi bi-box-arrow-in-right"></i> Sign In</button>
          </form>
        </div>

        <div class="auth-footer">
          <p>
            Don't have an account? <a href="{{ path('app_register') }}">Create one now</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
