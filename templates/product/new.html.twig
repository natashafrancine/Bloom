{% extends 'base.html.twig' %}

{% block title %}Add New Product - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mx-auto bg-white p-5 rounded-4 shadow-sm" style="max-width: 700px;">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-pink" style="font-family: 'Bauhaus 93'; font-size: 2.5rem;">🌸 Add New Product</h1>
            <p class="text-muted small">
                Fill in the product details below. Upload a clear image and ensure all fields are correct before saving.
            </p>
        </div>

        {{ form_start(form, {
            'attr': {
                'class': 'needs-validation',
                'novalidate': 'novalidate'
            },
            'multipart': true
        }) }}

        {# Include shared product form fields and scripts #}
        {{ include('product/_form.html.twig') }}

        <!-- Action Buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary px-4 py-2">← Back</a>
            <button type="submit" class="btn btn-pink px-4 py-2 text-white">💐 Save Product</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<!-- Styles -->
<style>
body {
    background-color: #FAFAFA;
    font-family: 'Poppins', sans-serif;
    color: #374151;
}
.text-pink { color: #DB2777; }
.form-label {
    font-weight: 600;
    color: #444;
    margin-bottom: 6px;
}
.form-control {
    border-radius: 12px;
    border: 1px solid #E5E7EB;
    padding: 12px 16px;
    font-size: 15px;
    transition: 0.3s ease;
}
.form-control:focus {
    border-color: #DB2777;
    box-shadow: 0 0 0 0.2rem rgba(219, 39, 119, 0.15);
}
.is-invalid { 
    border-color: #dc3545 !important;
    background-color: #ffe6e6;
}
.is-invalid:focus {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}
.invalid-feedback {
    display: block !important;
    color: #dc3545;
    font-size: 0.875rem;
    margin-top: 0.25rem;
}
.btn-pink {
    background-color: #DB2777;
    border: none;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-pink:hover {
    background-color: #BE185D;
    transform: translateY(-2px);
}
.btn-outline-secondary {
    border-color: #DB2777;
    color: #DB2777;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-outline-secondary:hover {
    background-color: #DB2777;
    color: white;
}
.shadow-sm { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important; }
.form-check-input:checked { background-color: #DB2777; border-color: #DB2777; }
@media (max-width: 576px) {
    .container { padding: 2rem 1rem; }
    .text-center h1 { font-size: 2rem; }
}
</style>
{% endblock %}
