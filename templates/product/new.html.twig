{% extends 'base.html.twig' %}

{% block title %}Add New Product - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mx-auto bg-white p-5 rounded-4 shadow-sm" style="max-width: 750px;">

        <div class="text-center mb-4">
            <h1 class="fw-bold text-pink" style="font-family: 'Bauhaus 93';">🌸 Add New Product</h1>
            <p class="text-muted small">Fill in the product details below. Upload a clear image and ensure all fields are correct before saving.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

        <div class="mb-3">
            {{ form_label(form.name, 'Product Name', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Elegant Rose Bouquet', 'required': true}}) }}
            <div class="invalid-feedback">{{ form_errors(form.name) }}</div>
        </div>

        <div class="mb-3">
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Write a short description...', 'required': true}}) }}
            <div class="invalid-feedback">{{ form_errors(form.description) }}</div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(form.price, 'Price (₱)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.price, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'required': true}}) }}
                <div class="invalid-feedback">{{ form_errors(form.price) }}</div>
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.stock, 'Stock Quantity', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.stock, {'attr': {'class': 'form-control', 'placeholder': '50', 'required': true}}) }}
                <div class="invalid-feedback">{{ form_errors(form.stock) }}</div>
            </div>
        </div>

        {% if form.image is defined %}
        <div class="mb-4">
            {{ form_label(form.image, 'Product Image', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.image, {'attr': {'class': 'form-control', 'onchange': 'previewImage(event)'}}) }}
            <div class="invalid-feedback">{{ form_errors(form.image) }}</div>

            <div class="text-center mt-3" id="imagePreviewContainer" style="display: none;">
                <img id="imagePreview" src="#" alt="Image Preview" class="img-thumbnail rounded-4 shadow-sm" style="max-height: 200px; object-fit: cover;">
            </div>
        </div>
        {% endif %}

        <div class="text-center mt-4">
            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary px-4 me-2">← Back</a>
            <button type="submit" class="btn btn-pink text-white px-4 shadow-sm">💐 Save Product</button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
function previewImage(event) {
    const input = event.target;
    const preview = document.getElementById('imagePreview');
    const container = document.getElementById('imagePreviewContainer');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            preview.src = e.target.result;
            container.style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    } else {
        preview.src = '#';
        container.style.display = 'none';
    }
}

(() => {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    });
})();
</script>

<style>
body { background-color: #FAFAFA; font-family: 'Poppins', sans-serif; color: #374151; }
.text-pink { color: #DB2777; }
.form-label { font-weight: 600; color: #444; margin-bottom: 6px; }
.form-control { border-radius: 10px; border: 1px solid #E5E7EB; padding: 10px 14px; font-size: 15px; transition: 0.3s ease; }
.form-control:focus { border-color: #DB2777; box-shadow: 0 0 0 0.2rem rgba(219, 39, 119, 0.15); }
.btn-pink { background-color: #DB2777; border: none; font-weight: 600; border-radius: 30px; transition: 0.3s ease; }
.btn-pink:hover { background-color: #BE185D; transform: translateY(-2px); }
.btn-outline-secondary { border-color: #DB2777; color: #DB2777; font-weight: 600; border-radius: 30px; transition: 0.3s ease; }
.btn-outline-secondary:hover { background-color: #DB2777; color: white; }
.shadow-sm { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important; }
</style>
{% endblock %}
