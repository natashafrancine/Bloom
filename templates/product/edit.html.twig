{% extends 'base.html.twig' %}

{% block title %}Edit {{ product.name }} - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mx-auto bg-white p-5 rounded-4 shadow-sm" style="max-width: 700px;">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-pink" style="font-family: 'Bauhaus 93 Regular'; font-size: 2.5rem;">Edit Product</h1>
            <p class="text-muted small">
                Update the product details below. Make sure all fields are correct before saving.
            </p>
        </div>

        <!-- Edit Form -->
        {{ form_start(form, {
            'action': path('product_edit', {'id': product.id}),
            'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'},
            'multipart': true
        }) }}

        {# Use the shared form partial (passes `product` for image preview) #}
        {{ include('product/_form.html.twig', { product: product }) }}

        <!-- Save Button -->
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <button type="submit" class="btn btn-pink px-4 py-2">💾 Save Changes</button>
        </div>

        {{ form_end(form) }}

        <!-- Separate Delete and Back Buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <!-- Delete -->
            <form method="post" action="{{ path('product_delete', {'id': product.id}) }}"
                  onsubmit="return confirm('Are you sure you want to delete this product?');" class="m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button class="btn btn-danger px-4 py-2">🗑️ Delete</button>
            </form>

            <!-- Back -->
            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary px-4 py-2">⬅️ Back to List</a>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
body {
    background-color: #FAFAFA;
    font-family: 'Poppins', sans-serif;
    color: #374151;
}
.text-pink { color: #DB2777; }
.form-label {
    font-weight: 600;
    color: #444;
    margin-bottom: 6px;
}
.form-control {
    border-radius: 12px;
    border: 1px solid #E5E7EB;
    padding: 12px 16px;
    font-size: 15px;
    transition: 0.3s ease;
}
.form-control:focus {
    border-color: #DB2777;
    box-shadow: 0 0 0 0.2rem rgba(219, 39, 119, 0.15);
}
.is-invalid { 
    border-color: #dc3545 !important;
    background-color: #ffe6e6;
}
.is-invalid:focus {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}
.invalid-feedback {
    display: block !important;
    color: #dc3545;
    font-size: 0.875rem;
    margin-top: 0.25rem;
}
.btn-pink {
    background-color: #DB2777;
    border: none;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-pink:hover {
    background-color: #BE185D;
    transform: translateY(-2px);
}
.btn-outline-secondary {
    border-color: #DB2777;
    color: #DB2777;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-outline-secondary:hover {
    background-color: #DB2777;
    color: white;
}
.btn-danger {
    border-radius: 30px;
    font-weight: 600;
    transition: 0.3s ease;
}
.shadow-sm { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important; }
.form-check-input:checked { background-color: #DB2777; border-color: #DB2777; }
@media (max-width: 576px) {
    .container { padding: 2rem 1rem; }
    .text-center h1 { font-size: 2rem; }
}
</style>
{% endblock %}
