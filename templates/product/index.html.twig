{% extends 'base.html.twig' %}

{% block title %}
  Products - BLOOM
{% endblock %}

{% block body %}
  <div class="text-center mb-5">
    <h1 style="font-family: 'Bauhaus 93 Regular', cursive; color: #DB2777;">Product Inventory</h1>
    <p class="fs-5 mt-3 text-muted" style="font-family: 'Cascadia Code', monospace;">Manage your beautiful blooms — view, edit, and organize all available products here 🌸</p>
  </div>

  <!-- Flash Messages -->
  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <div class="table-responsive">
    <!-- Category Filter Buttons -->
    <div class="category-filter-wrapper mb-4">
      <div class="filter-header text-center mb-3">
        <h5 class="text-muted fw-bold" style="color: #DB2777; letter-spacing: 0.5px;">🌸 Filter by Category</h5>
      </div>
      <div class="category-filter-container">
        <a href="{{ path('product_index') }}" class="category-btn category-btn-all {{ currentCategory is null ? 'active' : '' }}">
          <span class="filter-icon">📦</span>
          <span class="filter-text">All Categories</span>
        </a>
        {% for cat in categories %}
          <a href="{{ path('product_index', { category: cat.id }) }}" class="category-btn {% if currentCategory and currentCategory.id == cat.id %}{% endif %}">
            <span class="filter-icon">🌹</span>
            <span class="filter-text">{{ cat.name }}</span>
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- Add New Product Button - After Filter -->
    <div class="mb-4">
      <h5 class="text-muted" style="color: #DB2777; font-weight: 600;">📋 Your Products</h5>
    </div>

    {% if products is empty %}
      <div class="text-center py-5">
        <p class="text-muted fs-5">No products yet — start adding your lovely blooms 🌷</p>
      </div>
    {% else %}
      <!-- PRODUCT TABLE -->
      <table id="productTable" class="table table-bordered table-hover align-middle shadow-sm bg-white rounded-4 overflow-hidden">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Description</th>
            <th>Price (₱)</th>
            <th>Stock</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>

        <tbody>
          {% for p in products %}
            <tr>
              <td>{{ p.id }}</td>

              <td>
                {% if p.image %}
                  <img src="{{ asset('uploads/' ~ p.image) }}" alt="{{ p.name }}" class="product-thumb shadow-sm" />
                {% else %}
                  <span class="text-muted fst-italic small">No image</span>
                {% endif %}
              </td>

              <td class="fw-semibold">{{ p.name }}</td>

              <td class="text-muted small">{{ p.category ? p.category.name : '—' }}</td>

              <td class="text-muted small">{{ (p.description|length) > 80 ? (p.description|slice(0, 80)) ~ '...' : p.description }}</td>

              <td class="fw-semibold">₱{{ p.price|number_format(2, '.', ',') }}</td>

              <td>{{ p.stock }}</td>

              <td class="text-center">
                <div class="d-flex justify-content-center gap-2">
                  <a href="{{ path('product_show', { id: p.id }) }}" class="btn btn-outline-primary btn-sm">👁️ View</a>
                  <a href="{{ path('product_edit', { id: p.id }) }}" class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>

  <!-- DATATABLES -->
  <link rel="stylesheet" href="//cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="//cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

  <script>
$(document).ready(function() {
    $('#productTable').DataTable({
        pageLength: 5,
        lengthMenu: [5, 10, 20, 50],
        language: {
            search: "🔍 Search:",
            lengthMenu: "Show _MENU_ entries",
            zeroRecords: "No matching product found",
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            infoEmpty: "No products available",
            infoFiltered: "(filtered from _MAX_ total products)"
        },
        dom: '<"d-flex justify-content-between align-items-center mb-3"<"dataTables_search_wrapper"f><"dataTables_button_wrapper">>lrtip'
    });
    
    // Add the "Add New Product" button beside the search
    const addButton = '<a href="{{ path('product_new') }}" class="btn btn-pink px-3 py-2 shadow-sm" style="white-space: nowrap;">➕ Add New Product</a>';
    $('.dataTables_button_wrapper').html(addButton);
});

</script>

  <style>
    .category-filter-wrapper {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .category-filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    .category-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: #f8f9fa;
      border: 2px solid #e9ecef;
      border-radius: 8px;
      text-decoration: none;
      color: #495057;
      font-weight: 500;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .category-btn:hover {
      background: #e9ecef;
      border-color: #DB2777;
      color: #DB2777;
      transform: translateY(-2px);
    }

    .category-btn.active {
      background: #DB2777;
      border-color: #DB2777;
      color: white;
      box-shadow: 0 4px 12px rgba(219, 39, 119, 0.3);
    }

    .product-thumb {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 8px;
    }

    #productTable {
      border-collapse: collapse;
    }

    #productTable thead {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    #productTable th {
      color: #DB2777;
      font-weight: 700;
      border-bottom: 2px solid #DB2777;
      padding: 15px !important;
    }

    #productTable td {
      padding: 12px 15px !important;
      border-color: #e9ecef;
    }

    #productTable tbody tr {
      transition: all 0.3s ease;
    }

    #productTable tbody tr:hover {
      background-color: #FFF8FB;
      box-shadow: 0 2px 8px rgba(219, 39, 119, 0.1);
    }

    .btn-pink {
      background: linear-gradient(135deg, #DB2777 0%, #F472B6 100%);
      color: white;
      border: none;
    }

    .btn-pink:hover {
      background: linear-gradient(135deg, #c91f6d 0%, #f35fa8 100%);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(219, 39, 119, 0.3);
    }

    .dataTables_wrapper .dataTables_filter input {
      border-radius: 8px;
      border: 2px solid #e9ecef;
      padding: 8px 12px;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    .dataTables_wrapper .dataTables_filter input:focus {
      border-color: #DB2777;
      box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.1);
      outline: none;
    }

    .dataTables_wrapper .dataTables_length select {
      border-radius: 8px;
      border: 2px solid #e9ecef;
      padding: 6px 10px;
      font-size: 14px;
    }
  </style>
{% endblock %}
