{% extends 'base.html.twig' %}

{% block title %}Products - BLOOM{% endblock %}

{% block header %}
<aside class="sidebar">
  <div class="sidebar-content">
    <div class="text-center">
      <a href="{{ path('app_home') }}">
        <img src="{{ asset('uploads/bloom 2.png') }}" alt="Bloom Logo" class="logo-img">
      </a>
    </div>
    <nav class="mt-4">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" href="{{ path('app_home') }}">Dashboard Overview</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'product' %}active{% endif %}" href="{{ path('product_index') }}">Products</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'order' %}active{% endif %}" href="{{ path('order_index') }}">Orders</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'user' %}active{% endif %}" href="{{ path('user_index') }}">Users</a>
        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'activity_log' %}active{% endif %}" href="{{ path('activity_log_index') }}">Activity Logs</a>
    </nav>
  </div>

  {% if app.user %}
  <div class="user-info">
    <p class="mb-2 text-white-50 small">Logged in as:</p>
    <p class="mb-3 text-white">{{ app.user.email }}</p>
    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm w-100">Logout</a>
  </div>
  {% endif %}
</aside>
{% endblock %}



{% block body %}
<div class="text-center mb-5">
    <h1 style="font-family: 'Bauhaus 93 Regular', cursive; color: #DB2777;">Product Inventory</h1>
    <p class="fs-5 mt-3 text-muted" style="font-family: 'Cascadia Code', monospace;">
        Manage your beautiful blooms — view, edit, and organize all available products here 🌸
    </p>
</div>

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

<div class="table-responsive">
    <!-- Category Filter Buttons -->
    <div class="category-filter-wrapper mb-4">
        <div class="filter-header text-center mb-3">
            <h5 class="text-muted fw-bold" style="color: #DB2777; letter-spacing: 0.5px;">🌸 Filter by Category</h5>
        </div>
        <div class="category-filter-container">
            <a href="{{ path('product_index') }}"
               class="category-btn category-btn-all {{ currentCategory is null ? 'active' : '' }}">
                <span class="filter-icon">📦</span>
                <span class="filter-text">All Categories</span>
            </a>
            {% for cat in categories %}
                <a href="{{ path('product_index', { category: cat.id }) }}"
                   class="category-btn {% if currentCategory and currentCategory.id == cat.id %}active{% endif %}">
                    <span class="filter-icon">🌹</span>
                    <span class="filter-text">{{ cat.name }}</span>
                </a>
            {% endfor %}
        </div>
    </div>

    <!-- Add New Product Button - After Filter -->
    <div class="mb-4">
        <h5 class="text-muted" style="color: #DB2777; font-weight: 600;">📋 Your Products</h5>
    </div>

    {% if products is empty %}
        <div class="text-center py-5">
            <p class="text-muted fs-5">No products yet — start adding your lovely blooms 🌷</p>
        </div>
    {% else %}
        <!-- PRODUCT TABLE -->
        <table id="productTable" class="table table-bordered table-hover align-middle shadow-sm bg-white rounded-4 overflow-hidden">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Price (₱)</th>
                    <th>Stock</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for p in products %}
                <tr>
                    <td>{{ p.id }}</td>

                    <td>
                        {% if p.image %}
                            <img src="{{ asset('uploads/' ~ p.image) }}" alt="{{ p.name }}" class="product-thumb shadow-sm">
                        {% else %}
                            <span class="text-muted fst-italic small">No image</span>
                        {% endif %}
                    </td>

                    <td class="fw-semibold">{{ p.name }}</td>

                    <td class="text-muted small">{{ p.category ? p.category.name : '—' }}</td>

                    <td class="text-muted small">
                        {{ p.description|length > 80 ? p.description|slice(0, 80) ~ '...' : p.description }}
                    </td>

                    <td class="fw-semibold">₱{{ p.price|number_format(2, '.', ',') }}</td>

                    <td>{{ p.stock }}</td>

                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{ path('product_show', {'id': p.id}) }}" class="btn btn-outline-primary btn-sm">👁️ View</a>
                            <a href="{{ path('product_edit', {'id': p.id}) }}" class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<!-- DATATABLES -->
<link rel="stylesheet" href="//cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="//cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<script>
$(document).ready(function() {
    $('#productTable').DataTable({
        pageLength: 5,
        lengthMenu: [5, 10, 20, 50],
        language: {
            search: "🔍 Search:",
            lengthMenu: "Show _MENU_ entries",
            zeroRecords: "No matching product found",
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            infoEmpty: "No products available",
            infoFiltered: "(filtered from _MAX_ total products)"
        },
        dom: '<"d-flex justify-content-between align-items-center mb-3"<"dataTables_search_wrapper"f><"dataTables_button_wrapper">>lrtip'
    });
    
    // Add the "Add New Product" button beside the search
    const addButton = '<a href="{{ path('product_new') }}" class="btn btn-pink px-3 py-2 shadow-sm" style="white-space: nowrap;">➕ Add New Product</a>';
    $('.dataTables_button_wrapper').html(addButton);
});

</script>

<style>
body {
    font-family: 'Cascadia Code', monospace;
    background-color: #fff;
    background-image: url('{{ asset("uploads/pattern.png") }}');
    background-size: cover;
    background-attachment: fixed;
}

/* Product Thumb */
.product-thumb {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 12px;
    border: 2px solid #F9C5D1;
}

/* Pink Button */
.btn-pink {
    background-color: #DB2777;
    border-radius: 25px;
    color: white;
    font-weight: 600;
}
.btn-pink:hover { background-color: #BE185D; }

/* Category Filter Styles */
.category-filter-wrapper {
    background: linear-gradient(135deg, #F9C5D1 0%, #FFF0F6 100%);
    padding: 15px 12px;
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(219, 39, 119, 0.1);
    border: 2px solid rgba(219, 39, 119, 0.15);
}

.category-filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    align-items: center;
}

.category-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 6px 12px;
    border: 2px solid #E9B4D3;
    background-color: white;
    color: #666;
    border-radius: 25px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(219, 39, 119, 0.08);
}

.category-btn:hover {
    border-color: #DB2777;
    background-color: #FFF0F6;
    color: #DB2777;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(219, 39, 119, 0.2);
}

.category-btn.active {
    background: linear-gradient(135deg, #DB2777 0%, #BE185D 100%);
    color: white;
    border-color: #BE185D;
    box-shadow: 0 4px 15px rgba(219, 39, 119, 0.4);
    font-weight: 600;
}

.category-btn.active:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(219, 39, 119, 0.5);
}

.category-btn-all {
    background-color: #f8f9fa;
    border-color: #ddd;
}

.category-btn-all:hover {
    border-color: #999;
    color: #333;
}

.category-btn-all.active {
    background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
    border-color: #5a6268;
    color: white;
}

.filter-icon {
    font-size: 12px;
    display: inline-block;
}

.filter-text {
    display: inline-block;
    white-space: nowrap;
}

@media (max-width: 768px) {
    .category-filter-wrapper {
        padding: 12px 10px;
    }
    
    .category-btn {
        padding: 5px 10px;
        font-size: 11px;
    }
    
    .filter-icon {
        font-size: 11px;
    }
}

/* Row Hover */
.table-hover tbody tr:hover {
    background-color: #FFF0F6 !important;
}

</style>

{% endblock %}
