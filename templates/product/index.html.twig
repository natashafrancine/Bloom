{% extends 'base.html.twig' %}

{% block title %}Products - BLOOM{% endblock %}

{% block header %}
<aside class="sidebar">
  <div class="text-center">
    <a href="{{ path('app_home') }}">
      <img src="{{ asset('uploads/bloom 2.png') }}" alt="Bloom Logo" class="logo-img">
    </a>
  </div>
  <nav class="mt-4">
      <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" href="{{ path('app_home') }}">Dashboard Overview</a>
    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'product' %}active{% endif %}" href="{{ path('product_index') }}">Products</a>
    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'order' %}active{% endif %}" href="{{ path('order_index') }}">Orders</a>
    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'user' %}active{% endif %}" href="{{ path('user_index') }}">Users</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'activity_log' %}active{% endif %}" href="{{ path('activity_log_index') }}">Activity Logs</a>
  </nav>

</aside>
{% endblock %}



{% block body %}
<div class="text-center mb-5">
    <h1 style="font-family: 'Bauhaus 93 Regular', cursive; color: #DB2777;">Product Inventory</h1>
    <p class="fs-5 mt-3 text-muted" style="font-family: 'Cascadia Code', monospace;">
        Manage your beautiful blooms — view, edit, and organize all available products here 🌸
    </p>
    <a href="{{ path('product_new') }}" class="btn btn-pink mt-3 px-4 py-2 shadow-sm">
        ➕ Add New Product
    </a>
</div>

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

<div class="table-responsive">

    <!-- Category Filter Buttons -->
    <div class="mb-4 d-flex flex-wrap gap-2 justify-content-center">
        <a href="{{ path('product_index') }}"
           class="btn btn-sm btn-outline-secondary {{ currentCategory is null ? 'active' : '' }}">
            All Categories
        </a>
        {% for cat in categories %}
            <a href="{{ path('product_index', { category: cat.id }) }}"
               class="btn btn-sm {% if currentCategory and currentCategory.id == cat.id %}btn-pink{% else %}btn-outline-secondary{% endif %}">
                {{ cat.name }}
            </a>
        {% endfor %}
    </div>

    {% if products is empty %}
        <div class="text-center py-5">
            <p class="text-muted fs-5">No products yet — start adding your lovely blooms 🌷</p>
        </div>
    {% else %}
        <!-- PRODUCT TABLE -->
        <table id="productTable" class="table table-bordered table-hover align-middle shadow-sm bg-white rounded-4 overflow-hidden">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Price (₱)</th>
                    <th>Stock</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for p in products %}
                <tr>
                    <td>{{ p.id }}</td>

                    <td>
                        {% if p.image %}
                            <img src="{{ asset('uploads/' ~ p.image) }}" alt="{{ p.name }}" class="product-thumb shadow-sm">
                        {% else %}
                            <span class="text-muted fst-italic small">No image</span>
                        {% endif %}
                    </td>

                    <td class="fw-semibold">{{ p.name }}</td>

                    <td class="text-muted small">{{ p.category ? p.category.name : '—' }}</td>

                    <td class="text-muted small">
                        {{ p.description|length > 80 ? p.description|slice(0, 80) ~ '...' : p.description }}
                    </td>

                    <td class="fw-semibold">₱{{ p.price|number_format(2, '.', ',') }}</td>

                    <td>{{ p.stock }}</td>

                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{ path('product_show', {'id': p.id}) }}" class="btn btn-outline-primary btn-sm">👁️ View</a>
                            <a href="{{ path('product_edit', {'id': p.id}) }}" class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<!-- DATATABLES -->
<link rel="stylesheet" href="//cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="//cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<script>
$(document).ready(function() {
    $('#productTable').DataTable({
        pageLength: 5,
        lengthMenu: [5, 10, 20, 50],
        language: {
            search: "🔍 Search:",
            lengthMenu: "Show _MENU_ entries",
            zeroRecords: "No matching product found",
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            infoEmpty: "No products available",
            infoFiltered: "(filtered from _MAX_ total products)"
        }
    });
});

</script>

<style>
body {
    font-family: 'Cascadia Code', monospace;
    background-color: #fff;
    background-image: url('{{ asset("uploads/pattern.png") }}');
    background-size: cover;
    background-attachment: fixed;
}

/* Product Thumb */
.product-thumb {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 12px;
    border: 2px solid #F9C5D1;
}

/* Pink Button */
.btn-pink {
    background-color: #DB2777;
    border-radius: 25px;
    color: white;
    font-weight: 600;
}
.btn-pink:hover { background-color: #BE185D; }

/* Row Hover */
.table-hover tbody tr:hover {
    background-color: #FFF0F6 !important;
}

</style>

{% endblock %}
