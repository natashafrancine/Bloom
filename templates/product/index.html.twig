{% extends 'base.html.twig' %}

{% block title %}Products - BLOOM{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1 style="font-family: 'Bauhaus93 Regular', cursive; color: #DB2777;">Product Inventory</h1>
    <p class="fs-5 mt-3 text-muted" style="font-family: 'Cascadia Code', monospace;">
        Manage your beautiful blooms — view, edit, and organize all available products here 🌸
    </p>
    <a href="{{ path('product_new') }}" class="btn btn-pink mt-3 px-4 py-2 shadow-sm">
        ➕ Add New Product
    </a>
</div>

<!-- Flash Messages -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

<!-- Product Table -->
<div class="table-responsive">
    {% if products is empty %}
        <div class="text-center py-5">
            <p class="text-muted fs-5">No products yet — start adding your lovely blooms 🌷</p>
        </div>
    {% else %}
        <table id="productTable" class="table table-bordered table-hover align-middle shadow-sm bg-white rounded-4 overflow-hidden">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th> {# Added Category column #}
                    <th>Description</th>
                    <th>Price (₱)</th>
                    <th>Stock</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>
                            {% if product.image %}
                                <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}" class="product-thumb shadow-sm">
                            {% else %}
                                <span class="text-muted fst-italic small">No image</span>
                            {% endif %}
                        </td>
                        <td class="fw-semibold">{{ product.name }}</td>
                        <td class="text-muted small">
                            {{ product.category ? product.category.name : '—' }}
                        </td>
                        <td class="text-muted small">
                            {{ product.description|length > 80 ? product.description|slice(0, 80) ~ '...' : product.description }}
                        </td>
                        <td class="fw-semibold">₱{{ product.price|number_format(2, '.', ',') }}</td>
                        <td>{{ product.stock }}</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('product_show', {'id': product.id}) }}" class="btn btn-outline-primary btn-sm">👁️ View</a>
                                <a href="{{ path('product_edit', {'id': product.id}) }}" class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<!-- 🌸 DataTables CSS -->
<link rel="stylesheet" href="//cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css">

<!-- 🌸 jQuery + DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="//cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<!-- 🌸 Initialize DataTables -->
<script>
    $(document).ready(function() {
        $('#productTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 20, 50],
            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching products found",
                info: "Showing _START_ to _END_ of _TOTAL_ products",
                infoEmpty: "No products available",
                infoFiltered: "(filtered from _MAX_ total products)"
            }
        });
    });
</script>

<style>
    body {
        font-family: 'Cascadia Code', monospace;
        background-color: #fff;
        color: #374151;
        background-image: url('{{ asset("uploads/pattern.png") }}');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
        background-attachment: fixed;
    }

    h1 {
        font-size: 2.5rem;
        letter-spacing: 1px;
    }

    .table {
        border-radius: 16px;
        overflow: hidden;
    }

    .table thead {
        background-color: #FCE7F3;
        font-family: 'Cascadia Code', monospace;
        font-weight: 700;
        color: #DB2777;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .table-hover tbody tr:hover {
        background-color: #FFF0F6 !important;
        transition: 0.3s ease;
    }

    .product-thumb {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #F9C5D1;
    }

    .btn-pink {
        background-color: #DB2777;
        border: none;
        border-radius: 25px;
        font-family: 'Bauhaus93 Regular', cursive;
        color: white;
        font-weight: 600;
        transition: 0.3s ease;
    }

    .btn-pink:hover {
        background-color: #BE185D;
        transform: translateY(-2px);
    }

    .btn-outline-primary {
        border-color: #DB2777;
        color: #DB2777;
    }

    .btn-outline-primary:hover {
        background-color: #DB2777;
        color: #fff;
    }

    .btn-outline-secondary {
        border-color: #BE185D;
        color: #BE185D;
    }

    .btn-outline-secondary:hover {
        background-color: #BE185D;
        color: #fff;
    }

    .alert {
        border-radius: 12px;
        font-family: 'Cascadia Code', monospace;
    }
</style>
{% endblock %}
