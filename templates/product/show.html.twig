{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - BLOOM{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="mx-auto bg-white p-5 rounded-4 shadow-sm" style="max-width: 700px;">

        <!-- Product Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-pink" style="font-family: 'Bauhaus 93 Regular'; font-size: 2.5rem;">
                {{ product.name }}
                {% if product.shop %}
                    <span class="badge bg-pink text-white ms-2" style="font-size: 0.8rem;">In Shop</span>
                {% endif %}
            </h1>
        </div>

        <!-- Product Image -->
        {% if product.image %}
            <div class="text-center mb-4">
                <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}"
                     class="img-thumbnail rounded-4 shadow-sm" style="max-width: 300px; object-fit: cover;">
            </div>
        {% endif %}

        <!-- Product Details -->
        <div class="mb-3">
            <p><strong>Category:</strong> {{ product.category ? product.category.name : '—' }}</p>
            <p><strong>Description:</strong> {{ product.description }}</p>
            <p><strong>Price:</strong> ₱{{ product.price|number_format(2, '.', ',') }}</p>
            <p><strong>Stock:</strong> {{ product.stock }}</p>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary px-4 py-2">⬅️ Back to List</a>
            <a href="{{ path('product_edit', {'id': product.id}) }}" class="btn btn-pink px-4 py-2 text-white">✏️ Edit</a>
            {# Add/Remove from shop toggle form #}
            <form method="post" action="{{ path('product_toggle_shop', {'id': product.id}) }}" class="m-0">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-shop' ~ product.id) }}">
                {% if product.shop %}
                    <button class="btn btn-outline-danger px-4 py-2" type="submit">🗑️ Remove from Shop</button>
                {% else %}
                    <button class="btn btn-success px-4 py-2 text-white" type="submit">➕ Add to Shop</button>
                {% endif %}
            </form>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
body {
    background-color: #FAFAFA;
    font-family: 'Poppins', sans-serif;
    color: #374151;
}
.text-pink { color: #DB2777; }
.btn-pink {
    background-color: #DB2777;
    border: none;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-pink:hover {
    background-color: #BE185D;
    transform: translateY(-2px);
}
.btn-outline-secondary {
    border-color: #DB2777;
    color: #DB2777;
    font-weight: 600;
    border-radius: 30px;
    transition: 0.3s ease;
}
.btn-outline-secondary:hover {
    background-color: #DB2777;
    color: white;
}
.shadow-sm { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important; }
.img-thumbnail { border-radius: 12px; }
.badge.bg-pink {
    background-color: #DB2777;
}
@media (max-width: 576px) {
    .container { padding: 2rem 1rem; }
    .text-center h1 { font-size: 2rem; }
}
</style>
{% endblock %}
