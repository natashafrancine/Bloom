{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - BLOOM{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4" style="font-family: 'Bauhaus93 Regular', cursive; color: #DB2777;">{{ product.name }}</h1>

    {% if product.image %}
        <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}" class="img-thumbnail mb-3" style="width: 300px;">
    {% endif %}

    <p><strong>Category:</strong> {{ product.category ? product.category.name : '—' }}</p>
    <p><strong>Description:</strong> {{ product.description }}</p>
    <p><strong>Price:</strong> ₱{{ product.price|number_format(2, '.', ',') }}</p>
    <p><strong>Stock:</strong> {{ product.stock }}</p>

    <a href="{{ path('product_index') }}" class="btn btn-outline-secondary mt-3">⬅️ Back to List</a>
    <a href="{{ path('product_edit', {'id': product.id}) }}" class="btn btn-outline-primary mt-3">✏️ Edit</a>
</div>
{% endblock %}
