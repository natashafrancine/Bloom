<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}BLOOM{% endblock %}</title>

  <link rel="icon" type="image/png" href="{{ asset('uploads/bloom 2.png') }}">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  {% block stylesheets %}{% endblock %}
</head>

<body class="d-flex flex-column min-vh-100 fade-out">

  <!-- 🌸 Sidebar Navigation -->
  {% block header %}
  <aside class="sidebar">
    <div class="text-center">
      <a href="{% if app.router.has('app_home') %}{{ path('app_home') }}{% else %}#{% endif %}">
        <img src="{{ asset('uploads/bloom 2.png') }}" alt="Bloom Logo" class="logo-img">
        {# <span class="brand-text">Admin Panel</span> #}
      </a>
    </div>
    <nav class="mt-4">
      <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" 
         href="{% if app.router.has('app_home') %}{{ path('app_home') }}{% else %}#{% endif %}">Home</a>
      
      {# Commented links for future use #}
      <a class="nav-link {% if app.request.attributes.get('_route') == 'app_about' %}active{% endif %}" 
         href="{% if app.router.has('app_about') %}{{ path('app_about') }}{% else %}#{% endif %}">🌺 About</a>
      <a class="nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}" 
         href="{% if app.router.has('app_contact') %}{{ path('app_contact') }}{% else %}#{% endif %}">📞 Contact</a>

      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'shop' %}active{% endif %}" 
         href="{% if app.router.has('shop_index') %}{{ path('shop_index') }}{% else %}#{% endif %}">Shop</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'product' %}active{% endif %}" 
         href="{% if app.router.has('product_index') %}{{ path('product_index') }}{% else %}#{% endif %}">Products</a>
      <a class="nav-link {% if app.request.attributes.get('_route') starts with 'order' %}active{% endif %}" 
         href="{% if app.router.has('order_index') %}{{ path('order_index') }}{% else %}#{% endif %}">Orders</a>
    </nav>
  </aside>
  {% endblock %}

  <!-- 🌺 Main Content Area -->
  <div class="main-content flex-fill">
    <main>
      {% block body %}{% endblock %}
    </main>

    {% block footer %}
    <footer class="text-light text-center py-3 mt-4 rounded-bottom">
      <div class="container">
        <small>© {{ "now"|date("Y") }} Bloom Shop | All Rights Reserved 🌷</small>
      </div>
    </footer>
    {% endblock %}
  </div>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
