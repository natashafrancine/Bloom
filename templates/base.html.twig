<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,
        <svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22>
            <text y=%221.2em%22 font-size=%2296%22>🌸</text>
        </svg>">

    <!-- Symfony Stylesheets Block (for global CSS, Tailwind, etc.) -->
    {% block stylesheets %}{% endblock %}

    <!-- Custom Inline Styles Block -->
    {% block head_styles %}{% endblock %}
</head>
<body>
    <!-- Optional Global Header (Remove if not needed) -->
    {% block header %}{% endblock %}

    <!-- Main Page Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Symfony JavaScripts -->
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>
