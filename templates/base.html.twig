<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% block title %}
        BLOOM
      {% endblock %}
    </title>

    <link rel="icon" type="image/png" href="{{ asset('uploads/bloom 2.png') }}" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    {% block stylesheets %}
      <style>
        :root {
          --primary-pink: #E91E63;
          --dark-pink: #C2185B;
          --light-pink: #F06292;
          --accent-purple: #9C27B0;
          --light-bg: #FFF5F9;
          --text-color: #2C2C2C;
          --sidebar-width: 320px;
        }

        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        html, body {
          height: 100%;
        }

        body {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', sans-serif;
          color: var(--text-color);
          background: linear-gradient(135deg, var(--light-bg) 0%, #FCE4EC 100%);
          background-attachment: fixed;
          min-height: 100vh;
          overflow-x: hidden;
          display: flex;
          flex-direction: row;
        }

        /* ===== SIDEBAR STYLING ===== */
        .sidebar {
          position: fixed;
          top: 0;
          left: 0;
          width: var(--sidebar-width);
          height: 100vh;
          background: linear-gradient(180deg, var(--primary-pink) 0%, var(--accent-purple) 100%);
          box-shadow: 4px 0 30px rgba(233, 30, 99, 0.25);
          z-index: 1000;
          display: flex;
          flex-direction: column;
          overflow: hidden;
          padding: 0;
        }

        .sidebar::before {
          content: '';
          position: absolute;
          top: -50%;
          right: -50%;
          width: 500px;
          height: 500px;
          background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
          border-radius: 50%;
          filter: blur(40px);
          pointer-events: none;
        }

        .sidebar::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 100px;
          background: linear-gradient(to top, rgba(0,0,0,0.1), transparent);
          pointer-events: none;
        }

        .sidebar-content {
          flex: 1;
          overflow-y: auto;
          padding: 40px 20px 30px;
          display: flex;
          flex-direction: column;
          position: relative;
          z-index: 1;
        }

        .sidebar-content::-webkit-scrollbar {
          width: 8px;
        }

        .sidebar-content::-webkit-scrollbar-track {
          background: rgba(255, 255, 255, 0.08);
        }

        .sidebar-content::-webkit-scrollbar-thumb {
          background: rgba(255, 255, 255, 0.35);
          border-radius: 10px;
        }

        .sidebar-content::-webkit-scrollbar-thumb:hover {
          background: rgba(255, 255, 255, 0.55);
        }

        /* Logo */
        .logo-img {
          width: 100px;
          height: 100px;
          border-radius: 50%;
          object-fit: cover;
          margin: 0 auto 30px;
          border: 5px solid rgba(255, 255, 255, 0.3);
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25), inset 0 0 20px rgba(255, 255, 255, 0.1);
          transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
          cursor: pointer;
        }

        .logo-img:hover {
          transform: scale(1.12) rotateZ(-5deg);
          border-color: rgba(255, 255, 255, 0.7);
          box-shadow: 0 15px 50px rgba(0, 0, 0, 0.35), inset 0 0 20px rgba(255, 255, 255, 0.2);
        }

        /* Navigation */
        nav {
          display: flex;
          flex-direction: column;
          gap: 8px;
          margin-bottom: 30px;
        }

        .nav-link {
          color: white;
          text-decoration: none;
          display: flex;
          align-items: center;
          padding: 16px 20px;
          border-radius: 14px;
          transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
          font-weight: 600;
          font-size: 16px;
          position: relative;
          overflow: hidden;
          white-space: nowrap;
          text-overflow: ellipsis;
        }

        .nav-link::before {
          content: '';
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 4px;
          background: rgba(255, 255, 255, 0.8);
          transform: scaleY(0);
          transform-origin: top;
          transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .nav-link::after {
          content: '';
          position: absolute;
          inset: 0;
          background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
          opacity: 0;
          transition: opacity 0.3s ease;
        }

        .nav-link:hover {
          background: rgba(255, 255, 255, 0.2);
          transform: translateX(8px);
          box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .nav-link:hover::before {
          transform: scaleY(1);
        }

        .nav-link:hover::after {
          opacity: 1;
        }

        /* Active state */
        .nav-link[style*="background"] {
          background: rgba(255, 255, 255, 0.25) !important;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), inset 0 0 20px rgba(255, 255, 255, 0.1);
        }

        .nav-link[style*="background"]::before {
          transform: scaleY(1);
        }

        .nav-link i {
          font-size: 18px;
          min-width: 24px;
        }

        /* User Info */
        .user-info {
          border-top: 2px solid rgba(255, 255, 255, 0.2);
          padding: 24px 20px;
          margin-top: auto;
          position: relative;
          z-index: 2;
          background: rgba(0, 0, 0, 0.08);
          border-radius: 16px 16px 0 0;
          backdrop-filter: blur(10px);
        }

        .user-info p {
          margin: 0 0 14px 0;
          font-size: 12px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 1.5px;
          opacity: 0.9;
        }

        .user-info .dropdown-toggle {
          background: rgba(255, 255, 255, 0.95) !important;
          border: 2px solid rgba(255, 255, 255, 0.4) !important;
          color: var(--primary-pink) !important;
          font-weight: 700;
          font-size: 13px;
          padding: 10px 14px !important;
          transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
          border-radius: 10px !important;
        }

        .user-info .dropdown-toggle:hover {
          background: white !important;
          box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
          transform: translateY(-2px);
          border-color: rgba(233, 30, 99, 0.3) !important;
        }

        .user-info .dropdown-menu {
          border-radius: 12px;
          border: none;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
          margin-top: 8px;
        }

        .user-info .dropdown-item {
          padding: 12px 16px;
          font-weight: 500;
          transition: all 0.2s ease;
        }

        .user-info .dropdown-item:hover {
          background: #FFF0F5;
          color: var(--primary-pink);
        }

        /* ===== MAIN CONTENT ===== */
        .main-content {
          margin-left: var(--sidebar-width);
          padding: 40px;
          min-height: 100vh;
          flex: 1;
          overflow-y: auto;
        }

        .fade-out {
          animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
          from {
            opacity: 0;
            transform: translateY(15px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        /* Footer */
        footer {
          background: linear-gradient(135deg, var(--primary-pink) 0%, var(--accent-purple) 100%);
          margin-top: auto;
          border-radius: 16px 16px 0 0;
          box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
          color: white;
          padding: 20px !important;
        }

        .text-pink {
          color: var(--primary-pink);
        }

        .btn-pink {
          background: linear-gradient(135deg, var(--primary-pink) 0%, var(--light-pink) 100%);
          border: none;
          color: white;
          font-weight: 600;
          transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
          box-shadow: 0 4px 15px rgba(233, 30, 99, 0.3);
        }

        .btn-pink:hover {
          transform: translateY(-3px);
          box-shadow: 0 8px 30px rgba(233, 30, 99, 0.4);
          color: white;
        }

        h1, h2, h3, h4, h5, h6 {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          color: var(--text-color);
          font-weight: 700;
        }

        .container {
          max-width: 1200px;
        }

        /* Alert styling */
        .alert {
          border-radius: 12px;
          border: none;
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .alert-danger {
          background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
          color: #B71C1C;
          border-left: 4px solid #E53935;
        }

        .alert-success {
          background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
          color: #1B5E20;
          border-left: 4px solid #43A047;
        }

        /* ===== RESPONSIVE DESIGN ===== */
        @media (max-width: 768px) {
          :root {
            --sidebar-width: 100%;
          }

          body {
            flex-direction: column;
          }

          .sidebar {
            position: relative;
            width: 100%;
            height: auto;
            flex-direction: row;
            border-radius: 0 0 20px 20px;
          }

          .sidebar-content {
            padding: 12px;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
          }

          .logo-img {
            width: 60px;
            height: 60px;
            margin: 0 10px 0 0;
          }

          nav {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 6px;
            flex: 1;
            margin: 0;
          }

          .nav-link {
            padding: 10px 12px;
            font-size: 13px;
            flex: 0 1 auto;
          }

          .user-info {
            border-top: none;
            border-left: 2px solid rgba(255, 255, 255, 0.2);
            padding: 12px 15px;
            margin: 0;
            margin-left: auto;
            border-radius: 0;
            background: transparent;
          }

          .main-content {
            margin-left: 0;
            padding: 20px;
          }
        }
      </style>
    {% endblock %}
  </head>

  <body class="fade-out">
    <!-- 🌸 Sidebar Navigation -->
    {% block header %}
      <aside class="sidebar">
        <div class="sidebar-content">
          <div>
            <a href="{{ path('app_home') }}">
              <img src="{{ asset('uploads/bloom 2.png') }}" alt="Bloom Logo" class="logo-img" />
            </a>
          </div>
          <nav>
            <a class="nav-link" href="{{ path('app_home') }}" {% if app.request.attributes.get('_route') == 'app_home' %}style="background: rgba(255,255,255,0.25);"{% endif %}>
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a class="nav-link" href="{{ path('product_index') }}" {% if app.request.attributes.get('_route') starts with 'product' %}style="background: rgba(255,255,255,0.25);"{% endif %}>
              <i class="bi bi-flower1 me-2"></i> Products
            </a>
            <a class="nav-link" href="{{ path('order_index') }}" {% if app.request.attributes.get('_route') starts with 'order' %}style="background: rgba(255,255,255,0.25);"{% endif %}>
              <i class="bi bi-bag-check me-2"></i> Orders
            </a>
            {% if is_granted('ROLE_ADMIN') %}
              <a class="nav-link" href="{{ path('user_index') }}" {% if app.request.attributes.get('_route') starts with 'user' %}style="background: rgba(255,255,255,0.25);"{% endif %}>
                <i class="bi bi-people me-2"></i> Users
              </a>
              <a class="nav-link" href="{{ path('activity_log_index') }}" {% if app.request.attributes.get('_route') starts with 'activity_log' %}style="background: rgba(255,255,255,0.25);"{% endif %}>
                <i class="bi bi-clock-history me-2"></i> Activity
              </a>
            {% endif %}
          </nav>
        </div>

        {% if app.user %}
          <div class="user-info">
            <p>👤 Account</p>
            <div class="dropdown w-100">
              <button class="btn btn-light btn-sm w-100 dropdown-toggle" type="button" id="emailDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                {{ app.user.email }}
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="emailDropdown">
                <li>
                  <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#profileModal">
                    <i class="bi bi-person-circle me-2"></i> Profile
                  </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                    <i class="bi bi-box-arrow-left me-2"></i> Logout
                  </a>
                </li>
              </ul>
            </div>
          </div>
        {% endif %}
      </aside>
    {% endblock %}

    <!-- 🌺 Main Content Area -->
    <div class="main-content flex-fill">
      <main>
        {% for message in app.flashes('error') %}
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            {{ message|raw }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
        {% block body %}

        {% endblock %}
      </main>

      {% block footer %}
        <footer class="text-light text-center py-3 mt-4 rounded-bottom">
          <div class="container">
            <small>© {{ 'now'|date('Y') }} Bloom Shop | All Rights Reserved 🌷</small>
          </div>
        </footer>
      {% endblock %}
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Profile Modal -->
    {% if app.user %}
      <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header border-bottom" style="border-color: var(--pink) !important;">
              <h5 class="modal-title text-pink" id="profileModalLabel">Update Profile</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="profileForm">
              <div class="modal-body">
                <div class="mb-3">
                  <label for="profileEmail" class="form-label">Email Address</label>
                  <input type="email" class="form-control" id="profileEmail" placeholder="Enter new email" value="{{ app.user.email }}" />
                  <small class="form-text text-muted">Leave blank to keep current email</small>
                </div>
                <div class="mb-3">
                  <label for="profilePassword" class="form-label">New Password</label>
                  <input type="password" class="form-control" id="profilePassword" placeholder="Enter new password" />
                  <small class="form-text text-muted">Leave blank to keep current password</small>
                </div>
                <div class="mb-3">
                  <label for="profilePasswordConfirm" class="form-label">Confirm Password</label>
                  <input type="password" class="form-control" id="profilePasswordConfirm" placeholder="Confirm new password" />
                </div>
                <div id="profileErrorAlert" class="alert alert-danger d-none" role="alert"></div>
                <div id="profileSuccessAlert" class="alert alert-success d-none" role="alert"></div>
              </div>
              <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-pink" id="saveProfileBtn">Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    {% endif %}

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const saveProfileBtn = document.getElementById('saveProfileBtn');
        if (saveProfileBtn) {
          saveProfileBtn.addEventListener('click', function(e) {
            e.preventDefault();
            updateProfile();
          });
        }
      });

      function updateProfile() {
        const email = document.getElementById('profileEmail').value.trim();
        const password = document.getElementById('profilePassword').value;
        const passwordConfirm = document.getElementById('profilePasswordConfirm').value;
        const errorAlert = document.getElementById('profileErrorAlert');
        const successAlert = document.getElementById('profileSuccessAlert');

        errorAlert.classList.add('d-none');
        successAlert.classList.add('d-none');

        if (email === '' && password === '') {
          errorAlert.textContent = 'Please enter either a new email or password';
          errorAlert.classList.remove('d-none');
          return;
        }

        if (password && password !== passwordConfirm) {
          errorAlert.textContent = 'Passwords do not match';
          errorAlert.classList.remove('d-none');
          return;
        }

        if (password && password.length < 6) {
          errorAlert.textContent = 'Password must be at least 6 characters long';
          errorAlert.classList.remove('d-none');
          return;
        }

        const formData = new FormData();
        if (email) formData.append('email', email);
        if (password) formData.append('password', password);

        {% if app.user %}
        fetch('{{ path("user_profile_update", {"id": app.user.id}) }}', {
          method: 'POST',
          body: formData,
          headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            successAlert.textContent = data.message;
            successAlert.classList.remove('d-none');
            setTimeout(() => {
              location.reload();
            }, 1500);
          } else {
            errorAlert.textContent = data.message || 'An error occurred';
            errorAlert.classList.remove('d-none');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          errorAlert.textContent = 'An error occurred while updating your profile';
          errorAlert.classList.remove('d-none');
        });
        {% endif %}
      }
    </script>

    {% block javascripts %}
    {% endblock %}
  </body>
</html>
