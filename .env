# =======================================================
# Environment configuration for Bloom Symfony project
# =======================================================

# ---------------------------
# Symfony framework
# ---------------------------
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=ChangeThisToAStrongSecretKey
APP_URL=http://localhost:8000/

# ---------------------------
# Database configuration
# ---------------------------
MYSQL_ROOT_PASSWORD=test_demo_root_password
MYSQL_DATABASE=test_demo_db
MYSQL_USER=test_demo_user
MYSQL_PASSWORD=test_demo_password
DATABASE_URL="mysql://test_demo_user:test_demo_password@127.0.0.1:3307/test_demo_db?serverVersion=8.0.32&charset=utf8mb4"

# ---------------------------
# Messenger
# ---------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ---------------------------
# Mailer
# ---------------------------
MAILER_DSN=null://null

# ---------------------------
# Custom application parameters
# ---------------------------
APP_UPLOAD_DIR=public/uploads
APP_ADMIN_EMAIL=admin@bloom.com
APP_API_KEY=your_api_key_here

# ---------------------------
# Safe Twig Data Collector configuration
# ---------------------------
# Maximum recursion depth to prevent memory exhaustion
APP_TWIG_MAX_DEPTH=50

# ---------------------------
# Notes:
# ---------------------------
# - Do NOT commit production secrets into this file.
# - Use .env.local for local overrides.
# - Real environment variables always take precedence.
